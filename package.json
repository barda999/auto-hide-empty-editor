{
  "name": "auto-hide-empty-editor",
  "displayName": "Auto Hide Empty Editor",
  "description": "Hides the empty editor area so Claude Code and the Terminal fill the window when no files are open.",
  "version": "0.1.3",
  "publisher": "bardiazamanian",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barda999/auto-hide-empty-editor.git"
  },
  "bugs": {
    "url": "https://github.com/barda999/auto-hide-empty-editor/issues"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude code",
    "layout",
    "editor",
    "panel",
    "focus"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "autoHideEmptyEditor-panelHost",
          "title": "Claude Code",
          "icon": "resources/claude-host.svg"
        }
      ]
    },
    "views": {
      "autoHideEmptyEditor-panelHost": [
        {
          "id": "autoHideEmptyEditor.panelPlaceholder",
          "name": "Claude Code",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
